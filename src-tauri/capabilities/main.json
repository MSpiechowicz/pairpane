{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window. Grants only the app's own IPC commands. No core:* permission is granted: the UI calls nothing but invoke() of app commands, and Channel delivery (__TAURI_CHANNEL__ fetch) is not ACL-gated. No plugin permission is granted: opener/window-state/log/updater/dialog are driven from Rust only (the dialog asks before an external editor program is started, so the page must not be able to answer it), so their JS APIs stay unreachable from the webview.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-update-check",
    "allow-update-install",
    "allow-app-relaunch",
    "allow-menu-subscribe",
    "allow-pane-open",
    "allow-archive-open",
    "allow-archive-password",
    "allow-pane-folder-size",
    "allow-shell-run",
    "allow-shell-stop",
    "allow-terminal-open",
    "allow-find-start",
    "allow-find-cancel",
    "allow-find-forget",
    "allow-find-open",
    "allow-compare-start",
    "allow-compare-cancel",
    "allow-compare-forget",
    "allow-volumes-list",
    "allow-state-load",
    "allow-state-save",
    "allow-ops-subscribe",
    "allow-ops-start",
    "allow-ops-extract",
    "allow-ops-pack",
    "allow-ops-add-to-archive",
    "allow-ops-control",
    "allow-ops-answer",
    "allow-ops-rename",
    "allow-ops-trash",
    "allow-ops-untrash",
    "allow-ops-delete",
    "allow-ops-mkdir",
    "allow-ops-mkfile",
    "allow-ops-link",
    "allow-ops-task",
    "allow-ops-rename-undo",
    "allow-ops-sync-undo",
    "allow-ops-sync",
    "allow-rename-preview",
    "allow-ops-properties",
    "allow-view-open",
    "allow-archive-view-open",
    "allow-archive-edit-open",
    "allow-view-close",
    "allow-view-bytes",
    "allow-view-text",
    "allow-view-search",
    "allow-view-search-cancel",
    "allow-diff-next-difference",
    "allow-view-markdown",
    "allow-view-archive",
    "allow-view-image-decode",
    "allow-view-media",
    "allow-edit-open",
    "allow-edit-save",
    "allow-edit-external",
    "allow-settings-open",
    "allow-settings-editor",
    "allow-editor-set-dirty",
    "allow-editor-close-ack",
    "allow-app-close-confirmed"
  ]
}
