{
  "name": "pairpane",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MSpiechowicz/pairpane.git"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build": "tauri build",
    "tauri": "tauri",
    "check": "svelte-check --tsconfig ui/tsconfig.json --fail-on-warnings",
    "test": "vitest run --config ui/vitest.config.ts --passWithNoTests",
    "test:scripts": "bun test scripts/",
    "prepare": "git config core.hooksPath .githooks || true",
    "guard": "bun scripts/check-file-size.ts && bun scripts/check-case-collisions.ts && bun scripts/check-forbidden.ts && bun scripts/check-ipc-contract.ts",
    "dup": "jscpd --config .jscpd.json",
    "desktop-entry": "bun scripts/linux-desktop-entry.ts",
    "audit": "bun audit --ignore=GHSA-3g3m-2fjr-6pw4 --ignore=GHSA-g3hv-75wg-m249"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.4.4",
    "happy-dom": "^21.0.4",
    "jscpd": "^5.4.2",
    "semantic-release": "^25.0.9",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
